			"name": "US-17 — Cierre de Sesión",
			"description": "⚠️ IMPORTANTE: Ejecutar el test 1 (Login exitoso) antes de estos tests para tener un token válido.",
			"item": [
				{
					"name": "✅ 13. Logout exitoso",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 204 No Content', function () {",
									"    pm.response.to.have.status(204);",
