# ===========================================
# Variables de entorno para HiveHub Backend
# ===========================================
# Copia este archivo como .env y completa los valores.
# NUNCA commitees el archivo .env al repositorio.

# Base de datos
DB_USER=<tu-usuario>
DB_PASSWORD=<tu-password-segura>
DB_NAME=<tu-basedatos>

# JWT - OBLIGATORIO, mínimo 64 caracteres
# Genera tu secret con: openssl rand -base64 64
JWT_SECRET=<genera-tu-secret>
